# Copy to .env.prod on the server and fill in real secrets. DO NOT commit .env.prod.
#   openssl rand -base64 32   # for each secret below

# Postgres password (used by the db service AND the app's DATABASE_URL)
POSTGRES_PASSWORD=change-me-strong-password

# Auth.js session signing secret
AUTH_SECRET=change-me-openssl-rand-base64-32

# Optional: enterprise SSO via OIDC (Keycloak, Entra ID, Okta, Authentik,
# Google Workspace, …). Leave all blank to keep email/password login only.
# When set, a "Sign in with <name>" button appears on the login page. SSO only
# authenticates users who already have a Coworkee account (matched by email) —
# it never creates new accounts. Register this redirect URI at your provider:
#   https://<your-domain>/api/auth/callback/sso
# SSO_ISSUER=https://idp.example.com/realms/main
# SSO_CLIENT_ID=coworkee
# SSO_CLIENT_SECRET=change-me
# SSO_NAME=Company SSO
