generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum ContractType {
  PERMANENT
  TEMPORARY
  INTERN
  WORKING_STUDENT
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentCategory {
  CONTRACT
  PAYSLIP
  CERTIFICATE
  ID
  OTHER
}

enum ChecklistType {
  ONBOARDING
  OFFBOARDING
}

enum GoalStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

// ---- Employee conversations ("Mitarbeitergespräche" / 1:1s & annual talks) ----

// Question kind inside a talk agenda. SECTION is a non-answerable heading.
enum TalkItemType {
  SECTION
  TEXT
  RATING
  YESNO
}

enum TalkStatus {
  DRAFT     // manager is still preparing; invisible to the employee
  SHARED    // released to the employee; both sides prepare their answers
  COMPLETED // talk held and locked
}

// Which side an answer belongs to — manager and employee prepare independently.
enum TalkParty {
  MANAGER
  EMPLOYEE
}

// ---- Engagement surveys / pulse ----

enum SurveyStatus {
  DRAFT
  OPEN
  CLOSED
}

enum SurveyQuestionType {
  SCALE // 1..5 agreement
  NPS   // 0..10 net promoter
  TEXT  // free text
}

// ---- Skills matrix & succession planning ----

enum Readiness {
  READY_NOW
  ONE_TO_TWO_YEARS
  THREE_PLUS_YEARS
}

// ---- Expenses ----
enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

// ---- Assets / equipment ----
enum AssetStatus {
  AVAILABLE
  ASSIGNED
  RETIRED
}

// ---- Trainings / LMS ----
enum TrainingStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

// ---- Compensation ----
enum PayFrequency {
  MONTHLY
  YEARLY
  HOURLY
}

// ---- E-signatures ----
enum SignatureStatus {
  PENDING
  SIGNED
  DECLINED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  locale       String   @default("de")
  employee     Employee? @relation(fields: [employeeId], references: [id])
  employeeId   String?  @unique
  createdAt    DateTime @default(now())
  notifications Notification[]
  apiTokens    ApiToken[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Singleton row (id is always "singleton") holding org-wide outbound mail config.
// Secrets (smtpPassEnc, sendgridKeyEnc) are AES-256-GCM encrypted at rest (lib/crypto.ts).
model MailSettings {
  id            String   @id @default("singleton")
  provider      String   @default("LOG") // SMTP | SENDGRID | SENDMAIL | LOG
  fromEmail     String?
  fromName      String?
  smtpHost      String?
  smtpPort      Int?
  smtpSecure    Boolean  @default(false)
  smtpUser      String?
  smtpPassEnc   String?
  sendgridKeyEnc String?
  updatedAt     DateTime @updatedAt
}

model ApiToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  tokenHash  String    @unique
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?

  @@index([userId])
}

model Employee {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  birthDate    DateTime?
  street       String?
  city         String?
  country      String?
  hireDate     DateTime
  exitDate     DateTime?
  contractType ContractType @default(PERMANENT)
  workload     Int      @default(100)
  status       EmployeeStatus @default(ACTIVE)
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  position     Position?   @relation(fields: [positionId], references: [id])
  positionId   String?
  location     Location?   @relation(fields: [locationId], references: [id])
  locationId   String?
  manager      Employee?   @relation("Reports", fields: [managerId], references: [id])
  managerId    String?
  reports      Employee[]  @relation("Reports")
  user         User?
  ledDepartments Department[] @relation("DeptLead")
  leaveRequests LeaveRequest[] @relation("EmployeeLeaves")
  leaveApprovals LeaveRequest[] @relation("LeaveApprovals")
  leaveEntitlements LeaveEntitlement[]
  timeEntries  TimeEntry[] @relation("EmployeeTime")
  documents    Document[] @relation("EmployeeDocs")
  employeeChecklists EmployeeChecklist[] @relation("EmployeeChecklists")
  goals        Goal[]      @relation("EmployeeGoals")
  reviews      Review[]    @relation("EmployeeReviews")
  reviewsGiven Review[]    @relation("ReviewerReviews")
  talkTemplates TalkTemplate[] @relation("TalkTemplateOwner")
  talksAsSubject Talk[]     @relation("TalkSubject")
  talksAsManager Talk[]     @relation("TalkManager")
  skills       EmployeeSkill[] @relation("EmployeeSkills")
  successionRole SuccessionPlan? @relation("SuccessionRole")
  successionCandidacies SuccessionCandidate[] @relation("SuccessionCandidate")
  expenses     Expense[]   @relation("EmployeeExpenses")
  assets       Asset[]     @relation("EmployeeAssets")
  benefits     BenefitEnrollment[] @relation("EmployeeBenefits")
  trainings    TrainingEnrollment[] @relation("EmployeeTrainings")
  shifts       Shift[]     @relation("EmployeeShifts")
  compensation CompensationRecord[] @relation("EmployeeComp")
  signatureRequests SignatureRequest[] @relation("SignatureRequester")
  signaturesToSign  SignatureRequest[] @relation("SignatureSigner")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Department {
  id       String @id @default(cuid())
  name     String @unique
  lead     Employee? @relation("DeptLead", fields: [leadId], references: [id])
  leadId   String?
  employees Employee[]
  jobPostings JobPosting[]
}

model Position {
  id    String @id @default(cuid())
  title String @unique
  employees Employee[]
}

model Location {
  id      String @id @default(cuid())
  name    String @unique
  city    String?
  country String?
  employees Employee[]
  jobPostings JobPosting[]
}

model LeaveType {
  id          String   @id @default(cuid())
  name        String   @unique
  colorHex    String
  paid        Boolean  @default(true)
  defaultDays Int      @default(0)
  requests     LeaveRequest[]
  entitlements LeaveEntitlement[]
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employee     Employee    @relation("EmployeeLeaves", fields: [employeeId], references: [id])
  employeeId   String
  type         LeaveType   @relation(fields: [typeId], references: [id])
  typeId       String
  startDate    DateTime
  endDate      DateTime
  halfDayStart Boolean     @default(false)
  halfDayEnd   Boolean     @default(false)
  workingDays  Float
  reason       String?
  status       LeaveStatus @default(PENDING)
  approver     Employee?   @relation("LeaveApprovals", fields: [approverId], references: [id])
  approverId   String?
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime    @default(now())
}

model LeaveEntitlement {
  id         String    @id @default(cuid())
  employee   Employee  @relation(fields: [employeeId], references: [id])
  employeeId String
  type       LeaveType @relation(fields: [typeId], references: [id])
  typeId     String
  year       Int
  days       Float

  @@unique([employeeId, typeId, year])
}

model TimeEntry {
  id           String    @id @default(cuid())
  employee     Employee  @relation("EmployeeTime", fields: [employeeId], references: [id])
  employeeId   String
  date         DateTime
  start        DateTime
  end          DateTime?
  breakMinutes Int       @default(0)
  note         String?
  createdAt    DateTime  @default(now())

  @@index([employeeId, date])
}

model Document {
  id           String           @id @default(cuid())
  employee     Employee         @relation("EmployeeDocs", fields: [employeeId], references: [id])
  employeeId   String
  title        String
  category     DocumentCategory @default(OTHER)
  originalName String
  storedName   String           @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedAt   DateTime         @default(now())

  @@index([employeeId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entity      String
  entityId    String
  changes     Json?
  createdAt   DateTime @default(now())
}

model ChecklistTemplate {
  id    String                  @id @default(cuid())
  name  String                  @unique
  type  ChecklistType           @default(ONBOARDING)
  items ChecklistTemplateItem[]
}

model ChecklistTemplateItem {
  id         String            @id @default(cuid())
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  title      String
  sortOrder  Int               @default(0)
}

model EmployeeChecklist {
  id          String          @id @default(cuid())
  employee    Employee        @relation("EmployeeChecklists", fields: [employeeId], references: [id])
  employeeId  String
  type        ChecklistType
  title       String
  createdAt   DateTime        @default(now())
  completedAt DateTime?
  tasks       ChecklistTask[]

  @@index([employeeId])
}

model ChecklistTask {
  id          String            @id @default(cuid())
  checklist   EmployeeChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  checklistId String
  title       String
  done        Boolean           @default(false)
  doneAt      DateTime?
  sortOrder   Int               @default(0)
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  authorId  String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pinned, createdAt])
}

model Goal {
  id          String     @id @default(cuid())
  employee    Employee   @relation("EmployeeGoals", fields: [employeeId], references: [id])
  employeeId  String
  title       String
  description String?
  status      GoalStatus @default(OPEN)
  progress    Int        @default(0)
  dueDate     DateTime?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([employeeId])
}

model Review {
  id           String       @id @default(cuid())
  employee     Employee     @relation("EmployeeReviews", fields: [employeeId], references: [id])
  employeeId   String
  reviewer     Employee     @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  reviewerId   String
  period       String
  status       ReviewStatus @default(DRAFT)
  rating       Int?
  strengths    String?
  improvements String?
  comments     String?
  createdAt    DateTime     @default(now())
  submittedAt  DateTime?

  @@index([employeeId])
}

model JobPosting {
  id             String       @id @default(cuid())
  title          String
  description    String
  employmentType String?
  status         JobStatus    @default(DRAFT)
  department     Department?  @relation(fields: [departmentId], references: [id])
  departmentId   String?
  location       Location?    @relation(fields: [locationId], references: [id])
  locationId     String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  applications   Application[]
}

// `title` stores an i18n KEY (e.g. "notifications.leaveDecided"), not a
// rendered string — we don't reliably know the recipient's locale at emit
// time, so the UI translates `title` via the `notifications` namespace using
// the viewer's current locale. `body` is a short pre-rendered detail string
// (names/dates), safe to store raw since it's data, not UI chrome.
model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model Application {
  id           String           @id @default(cuid())
  jobPosting   JobPosting       @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  jobPostingId String
  firstName    String
  lastName     String
  email        String
  phone        String?
  stage        ApplicationStage @default(APPLIED)
  rating       Int?
  notes        String?
  appliedAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([jobPostingId, stage])
}

// A reusable talk agenda a manager (or HR/ADMIN) designs: how the conversation
// runs. `shared` templates are offered to every manager when scheduling; a
// non-shared template stays private to its owner.
model TalkTemplate {
  id          String             @id @default(cuid())
  title       String
  description String?
  owner       Employee           @relation("TalkTemplateOwner", fields: [ownerId], references: [id])
  ownerId     String
  shared      Boolean            @default(false)
  items       TalkTemplateItem[]
  talks       Talk[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([ownerId])
}

model TalkTemplateItem {
  id         String       @id @default(cuid())
  template   TalkTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  order      Int
  type       TalkItemType @default(TEXT)
  prompt     String
  helpText   String?
  required   Boolean      @default(false)

  @@index([templateId, order])
}

// A scheduled/held conversation between an employee (subject) and their manager.
// The agenda is snapshotted into TalkItem rows at creation, so later edits or
// deletion of the source template never mutate a talk in flight.
model Talk {
  id          String        @id @default(cuid())
  template    TalkTemplate? @relation(fields: [templateId], references: [id])
  templateId  String?
  employee    Employee      @relation("TalkSubject", fields: [employeeId], references: [id])
  employeeId  String
  manager     Employee      @relation("TalkManager", fields: [managerId], references: [id])
  managerId   String
  title       String
  scheduledAt DateTime?
  status      TalkStatus    @default(DRAFT)
  summary     String?
  items       TalkItem[]
  answers     TalkAnswer[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  completedAt DateTime?

  @@index([employeeId])
  @@index([managerId])
}

model TalkItem {
  id       String       @id @default(cuid())
  talk     Talk         @relation(fields: [talkId], references: [id], onDelete: Cascade)
  talkId   String
  order    Int
  type     TalkItemType
  prompt   String
  helpText String?
  required Boolean      @default(false)
  answers  TalkAnswer[]

  @@index([talkId, order])
}

// One answer per (agenda item, side). Manager and employee fill their own
// column independently, then compare them in the talk.
model TalkAnswer {
  id        String    @id @default(cuid())
  talk      Talk      @relation(fields: [talkId], references: [id], onDelete: Cascade)
  talkId    String
  item      TalkItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  party     TalkParty
  text      String?
  rating    Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([itemId, party])
  @@index([talkId])
}

// An engagement/pulse survey. Answers are decoupled from identity: when
// `anonymous`, responses carry no respondentId. A separate participation marker
// still prevents double-submission without linking a person to their answers.
model Survey {
  id             String                @id @default(cuid())
  title          String
  description    String?
  status         SurveyStatus          @default(DRAFT)
  anonymous      Boolean               @default(true)
  createdById    String
  closesAt       DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  questions      SurveyQuestion[]
  responses      SurveyResponse[]
  participations SurveyParticipation[]
}

model SurveyQuestion {
  id       String             @id @default(cuid())
  survey   Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  surveyId String
  order    Int
  type     SurveyQuestionType @default(SCALE)
  prompt   String
  required Boolean            @default(true)
  answers  SurveyAnswer[]

  @@index([surveyId, order])
}

model SurveyResponse {
  id           String         @id @default(cuid())
  survey       Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  surveyId     String
  respondentId String? // null for anonymous surveys
  submittedAt  DateTime       @default(now())
  answers      SurveyAnswer[]

  @@index([surveyId])
}

model SurveyAnswer {
  id         String         @id @default(cuid())
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  responseId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  value      Int?
  text       String?

  @@index([questionId])
}

// Records that an employee submitted a given survey — dedupe without revealing,
// for anonymous surveys, what they answered.
model SurveyParticipation {
  id         String   @id @default(cuid())
  survey     Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  surveyId   String
  employeeId String
  createdAt  DateTime @default(now())

  @@unique([surveyId, employeeId])
}

// A named competency employees can be rated on.
model Skill {
  id             String          @id @default(cuid())
  name           String          @unique
  category       String?
  createdAt      DateTime        @default(now())
  employeeSkills EmployeeSkill[]
}

model EmployeeSkill {
  id         String   @id @default(cuid())
  employee   Employee @relation("EmployeeSkills", fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId    String
  level      Int // 1..5
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, skillId])
  @@index([skillId])
}

// Succession plan for one key role holder, with ranked internal candidates.
model SuccessionPlan {
  id           String                @id @default(cuid())
  roleHolder   Employee              @relation("SuccessionRole", fields: [roleHolderId], references: [id], onDelete: Cascade)
  roleHolderId String                @unique
  notes        String?
  createdById  String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  candidates   SuccessionCandidate[]
}

model SuccessionCandidate {
  id          String         @id @default(cuid())
  plan        SuccessionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId      String
  candidate   Employee       @relation("SuccessionCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String
  readiness   Readiness      @default(ONE_TO_TWO_YEARS)
  notes       String?

  @@unique([planId, candidateId])
}

// An expense claim an employee submits; a manager/HR approves or rejects, then
// HR marks it reimbursed. Amounts are integer minor units (cents).
model Expense {
  id          String        @id @default(cuid())
  employee    Employee      @relation("EmployeeExpenses", fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  title       String
  category    String?
  amountCents Int
  currency    String        @default("EUR")
  spentAt     DateTime
  status      ExpenseStatus @default(PENDING)
  note        String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([employeeId])
  @@index([status])
}

// A company asset that can be assigned to an employee and later returned.
model Asset {
  id           String      @id @default(cuid())
  name         String
  category     String?
  serialNumber String?
  status       AssetStatus @default(AVAILABLE)
  assignedTo   Employee?   @relation("EmployeeAssets", fields: [assignedToId], references: [id])
  assignedToId String?
  assignedAt   DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([assignedToId])
}

model Benefit {
  id          String              @id @default(cuid())
  name        String
  description String?
  category    String?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  enrollments BenefitEnrollment[]
}

model BenefitEnrollment {
  id         String   @id @default(cuid())
  benefit    Benefit  @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  benefitId  String
  employee   Employee @relation("EmployeeBenefits", fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  note       String?
  enrolledAt DateTime @default(now())

  @@unique([benefitId, employeeId])
  @@index([employeeId])
}

model Course {
  id          String               @id @default(cuid())
  title       String
  description String?
  provider    String?
  url         String?
  createdAt   DateTime             @default(now())
  enrollments TrainingEnrollment[]
}

model TrainingEnrollment {
  id          String         @id @default(cuid())
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  employee    Employee       @relation("EmployeeTrainings", fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  status      TrainingStatus @default(ASSIGNED)
  assignedAt  DateTime       @default(now())
  completedAt DateTime?

  @@unique([courseId, employeeId])
  @@index([employeeId])
}

// A scheduled shift for one employee. Times are minutes from midnight so a
// shift is a plain (date, startMin, endMin) with no timezone math.
model Shift {
  id          String   @id @default(cuid())
  employee    Employee @relation("EmployeeShifts", fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  date        DateTime
  startMin    Int
  endMin      Int
  role        String?
  location    String?
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([employeeId, date])
  @@index([date])
}

// A compensation entry — the salary history per employee. HR/ADMIN only. Not a
// payroll engine: no tax, no payslip runs.
model CompensationRecord {
  id            String       @id @default(cuid())
  employee      Employee     @relation("EmployeeComp", fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId    String
  amountCents   Int
  currency      String       @default("EUR")
  frequency     PayFrequency @default(MONTHLY)
  effectiveDate DateTime
  note          String?
  createdById   String
  createdAt     DateTime     @default(now())

  @@index([employeeId, effectiveDate])
}

// A lightweight signature request: the signer types their name to sign. This is
// an acknowledgement record, not a cryptographic / qualified e-signature.
model SignatureRequest {
  id          String          @id @default(cuid())
  title       String
  body        String
  documentId  String?
  requester   Employee        @relation("SignatureRequester", fields: [requesterId], references: [id])
  requesterId String
  signer      Employee        @relation("SignatureSigner", fields: [signerId], references: [id], onDelete: Cascade)
  signerId    String
  status      SignatureStatus @default(PENDING)
  signedName  String?
  signedAt    DateTime?
  createdAt   DateTime        @default(now())

  @@index([signerId])
  @@index([requesterId])
}

// Singleton row (id is always "singleton") holding org-wide branding set during first-run setup.
model CompanySettings {
  id            String   @id @default("singleton")
  companyName   String
  defaultLocale String   @default("de")
  accentColor   String   @default("#6366f1")
  themePreset   String   @default("default")
  logoPath      String?
  createdAt     DateTime @default(now())
}
