generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum ContractType {
  PERMANENT
  TEMPORARY
  INTERN
  WORKING_STUDENT
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentCategory {
  CONTRACT
  PAYSLIP
  CERTIFICATE
  ID
  OTHER
}

enum ChecklistType {
  ONBOARDING
  OFFBOARDING
}

enum GoalStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

// ---- Employee conversations ("Mitarbeitergespräche" / 1:1s & annual talks) ----

// Question kind inside a talk agenda. SECTION is a non-answerable heading.
enum TalkItemType {
  SECTION
  TEXT
  RATING
  YESNO
}

enum TalkStatus {
  DRAFT     // manager is still preparing; invisible to the employee
  SHARED    // released to the employee; both sides prepare their answers
  COMPLETED // talk held and locked
}

// Which side an answer belongs to — manager and employee prepare independently.
enum TalkParty {
  MANAGER
  EMPLOYEE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  locale       String   @default("de")
  employee     Employee? @relation(fields: [employeeId], references: [id])
  employeeId   String?  @unique
  createdAt    DateTime @default(now())
  notifications Notification[]
  apiTokens    ApiToken[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Singleton row (id is always "singleton") holding org-wide outbound mail config.
// Secrets (smtpPassEnc, sendgridKeyEnc) are AES-256-GCM encrypted at rest (lib/crypto.ts).
model MailSettings {
  id            String   @id @default("singleton")
  provider      String   @default("LOG") // SMTP | SENDGRID | SENDMAIL | LOG
  fromEmail     String?
  fromName      String?
  smtpHost      String?
  smtpPort      Int?
  smtpSecure    Boolean  @default(false)
  smtpUser      String?
  smtpPassEnc   String?
  sendgridKeyEnc String?
  updatedAt     DateTime @updatedAt
}

model ApiToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  tokenHash  String    @unique
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?

  @@index([userId])
}

model Employee {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  birthDate    DateTime?
  street       String?
  city         String?
  country      String?
  hireDate     DateTime
  exitDate     DateTime?
  contractType ContractType @default(PERMANENT)
  workload     Int      @default(100)
  status       EmployeeStatus @default(ACTIVE)
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  position     Position?   @relation(fields: [positionId], references: [id])
  positionId   String?
  location     Location?   @relation(fields: [locationId], references: [id])
  locationId   String?
  manager      Employee?   @relation("Reports", fields: [managerId], references: [id])
  managerId    String?
  reports      Employee[]  @relation("Reports")
  user         User?
  ledDepartments Department[] @relation("DeptLead")
  leaveRequests LeaveRequest[] @relation("EmployeeLeaves")
  leaveApprovals LeaveRequest[] @relation("LeaveApprovals")
  leaveEntitlements LeaveEntitlement[]
  timeEntries  TimeEntry[] @relation("EmployeeTime")
  documents    Document[] @relation("EmployeeDocs")
  employeeChecklists EmployeeChecklist[] @relation("EmployeeChecklists")
  goals        Goal[]      @relation("EmployeeGoals")
  reviews      Review[]    @relation("EmployeeReviews")
  reviewsGiven Review[]    @relation("ReviewerReviews")
  talkTemplates TalkTemplate[] @relation("TalkTemplateOwner")
  talksAsSubject Talk[]     @relation("TalkSubject")
  talksAsManager Talk[]     @relation("TalkManager")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Department {
  id       String @id @default(cuid())
  name     String @unique
  lead     Employee? @relation("DeptLead", fields: [leadId], references: [id])
  leadId   String?
  employees Employee[]
  jobPostings JobPosting[]
}

model Position {
  id    String @id @default(cuid())
  title String @unique
  employees Employee[]
}

model Location {
  id      String @id @default(cuid())
  name    String @unique
  city    String?
  country String?
  employees Employee[]
  jobPostings JobPosting[]
}

model LeaveType {
  id          String   @id @default(cuid())
  name        String   @unique
  colorHex    String
  paid        Boolean  @default(true)
  defaultDays Int      @default(0)
  requests     LeaveRequest[]
  entitlements LeaveEntitlement[]
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employee     Employee    @relation("EmployeeLeaves", fields: [employeeId], references: [id])
  employeeId   String
  type         LeaveType   @relation(fields: [typeId], references: [id])
  typeId       String
  startDate    DateTime
  endDate      DateTime
  halfDayStart Boolean     @default(false)
  halfDayEnd   Boolean     @default(false)
  workingDays  Float
  reason       String?
  status       LeaveStatus @default(PENDING)
  approver     Employee?   @relation("LeaveApprovals", fields: [approverId], references: [id])
  approverId   String?
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime    @default(now())
}

model LeaveEntitlement {
  id         String    @id @default(cuid())
  employee   Employee  @relation(fields: [employeeId], references: [id])
  employeeId String
  type       LeaveType @relation(fields: [typeId], references: [id])
  typeId     String
  year       Int
  days       Float

  @@unique([employeeId, typeId, year])
}

model TimeEntry {
  id           String    @id @default(cuid())
  employee     Employee  @relation("EmployeeTime", fields: [employeeId], references: [id])
  employeeId   String
  date         DateTime
  start        DateTime
  end          DateTime?
  breakMinutes Int       @default(0)
  note         String?
  createdAt    DateTime  @default(now())

  @@index([employeeId, date])
}

model Document {
  id           String           @id @default(cuid())
  employee     Employee         @relation("EmployeeDocs", fields: [employeeId], references: [id])
  employeeId   String
  title        String
  category     DocumentCategory @default(OTHER)
  originalName String
  storedName   String           @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedAt   DateTime         @default(now())

  @@index([employeeId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entity      String
  entityId    String
  changes     Json?
  createdAt   DateTime @default(now())
}

model ChecklistTemplate {
  id    String                  @id @default(cuid())
  name  String                  @unique
  type  ChecklistType           @default(ONBOARDING)
  items ChecklistTemplateItem[]
}

model ChecklistTemplateItem {
  id         String            @id @default(cuid())
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  title      String
  sortOrder  Int               @default(0)
}

model EmployeeChecklist {
  id          String          @id @default(cuid())
  employee    Employee        @relation("EmployeeChecklists", fields: [employeeId], references: [id])
  employeeId  String
  type        ChecklistType
  title       String
  createdAt   DateTime        @default(now())
  completedAt DateTime?
  tasks       ChecklistTask[]

  @@index([employeeId])
}

model ChecklistTask {
  id          String            @id @default(cuid())
  checklist   EmployeeChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  checklistId String
  title       String
  done        Boolean           @default(false)
  doneAt      DateTime?
  sortOrder   Int               @default(0)
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  authorId  String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pinned, createdAt])
}

model Goal {
  id          String     @id @default(cuid())
  employee    Employee   @relation("EmployeeGoals", fields: [employeeId], references: [id])
  employeeId  String
  title       String
  description String?
  status      GoalStatus @default(OPEN)
  progress    Int        @default(0)
  dueDate     DateTime?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([employeeId])
}

model Review {
  id           String       @id @default(cuid())
  employee     Employee     @relation("EmployeeReviews", fields: [employeeId], references: [id])
  employeeId   String
  reviewer     Employee     @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  reviewerId   String
  period       String
  status       ReviewStatus @default(DRAFT)
  rating       Int?
  strengths    String?
  improvements String?
  comments     String?
  createdAt    DateTime     @default(now())
  submittedAt  DateTime?

  @@index([employeeId])
}

model JobPosting {
  id             String       @id @default(cuid())
  title          String
  description    String
  employmentType String?
  status         JobStatus    @default(DRAFT)
  department     Department?  @relation(fields: [departmentId], references: [id])
  departmentId   String?
  location       Location?    @relation(fields: [locationId], references: [id])
  locationId     String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  applications   Application[]
}

// `title` stores an i18n KEY (e.g. "notifications.leaveDecided"), not a
// rendered string — we don't reliably know the recipient's locale at emit
// time, so the UI translates `title` via the `notifications` namespace using
// the viewer's current locale. `body` is a short pre-rendered detail string
// (names/dates), safe to store raw since it's data, not UI chrome.
model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model Application {
  id           String           @id @default(cuid())
  jobPosting   JobPosting       @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  jobPostingId String
  firstName    String
  lastName     String
  email        String
  phone        String?
  stage        ApplicationStage @default(APPLIED)
  rating       Int?
  notes        String?
  appliedAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([jobPostingId, stage])
}

// A reusable talk agenda a manager (or HR/ADMIN) designs: how the conversation
// runs. `shared` templates are offered to every manager when scheduling; a
// non-shared template stays private to its owner.
model TalkTemplate {
  id          String             @id @default(cuid())
  title       String
  description String?
  owner       Employee           @relation("TalkTemplateOwner", fields: [ownerId], references: [id])
  ownerId     String
  shared      Boolean            @default(false)
  items       TalkTemplateItem[]
  talks       Talk[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([ownerId])
}

model TalkTemplateItem {
  id         String       @id @default(cuid())
  template   TalkTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  order      Int
  type       TalkItemType @default(TEXT)
  prompt     String
  helpText   String?
  required   Boolean      @default(false)

  @@index([templateId, order])
}

// A scheduled/held conversation between an employee (subject) and their manager.
// The agenda is snapshotted into TalkItem rows at creation, so later edits or
// deletion of the source template never mutate a talk in flight.
model Talk {
  id          String        @id @default(cuid())
  template    TalkTemplate? @relation(fields: [templateId], references: [id])
  templateId  String?
  employee    Employee      @relation("TalkSubject", fields: [employeeId], references: [id])
  employeeId  String
  manager     Employee      @relation("TalkManager", fields: [managerId], references: [id])
  managerId   String
  title       String
  scheduledAt DateTime?
  status      TalkStatus    @default(DRAFT)
  summary     String?
  items       TalkItem[]
  answers     TalkAnswer[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  completedAt DateTime?

  @@index([employeeId])
  @@index([managerId])
}

model TalkItem {
  id       String       @id @default(cuid())
  talk     Talk         @relation(fields: [talkId], references: [id], onDelete: Cascade)
  talkId   String
  order    Int
  type     TalkItemType
  prompt   String
  helpText String?
  required Boolean      @default(false)
  answers  TalkAnswer[]

  @@index([talkId, order])
}

// One answer per (agenda item, side). Manager and employee fill their own
// column independently, then compare them in the talk.
model TalkAnswer {
  id        String    @id @default(cuid())
  talk      Talk      @relation(fields: [talkId], references: [id], onDelete: Cascade)
  talkId    String
  item      TalkItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  party     TalkParty
  text      String?
  rating    Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([itemId, party])
  @@index([talkId])
}

// Singleton row (id is always "singleton") holding org-wide branding set during first-run setup.
model CompanySettings {
  id            String   @id @default("singleton")
  companyName   String
  defaultLocale String   @default("de")
  accentColor   String   @default("#6366f1")
  themePreset   String   @default("default")
  logoPath      String?
  createdAt     DateTime @default(now())
}
